PORT=3000
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=qpons
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_SYNCHRONIZE=true
DB_SSL=false
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
OTP_FROM_EMAIL=QPONS VIP <no-reply@your-verified-domain.com>
# Habilita solo localmente para mostrar el OTP en la pantalla; nunca usar en produccion.
OTP_DEV_MODE=false
# Modo temporal de demo: solo estos correos reciben el codigo de prueba en la respuesta.
OTP_TEST_MODE=false
OTP_TEST_EMAILS=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Cloudinary is optional in development; production uploads require all three values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Actívala solo durante la carga manual de empresas ficticias en una base demo.
ALLOW_DEMO_SEED=false
